includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - phpstan-baseline.neon
    - phpstan-include.php

parameters:
    level: 10
    strictRules:
        # larastan 把 Eloquent 静态 Builder 调用（Model::where()/limit() 等）与
        # $request->validate()（__call 宏）解析为“动态调用静态方法”，这是 Laravel
        # 官方惯用法而非真实问题；框架层面无法改写，故仅关闭该规则。
        # 真实的 $service::static() 动态调用已在代码中修复（LicenseManager/AiService）。
        dynamicCallOnStaticMethod: false
    paths:
        - app
        - routes
        - config
        - database
        - tests
    bootstrapFiles:
        - phpstan-bootstrap.php
    ignoreErrors:
        -
            # Settings 的点分路径（settings_get('main.title')）以 stdClass 动态属性
            # 逐级寻址为核心实现，动态属性名来自用户键名分段，无法静态化。
            path: app/Support/Settings.php
            identifier: property.dynamicName
        -
            # nullsafe.neverNull 是 phpstan 2.1 的风格规则：对 `?->prop ?? $default` 模式，
            # 官方建议改写为 `->prop ?? $default`（依赖 PHP 对 null 属性读取返回 null 的语义），
            # 但该写法在左值为 null 时会产生运行时 Warning。本项目的 ?-> 是有意的防御式写法，
            # 语义清晰且无副作用，故显式忽略该规则（区别于 baseline：此处是规则裁剪而非错误待修）。
            message: '#^Using nullsafe property access "[^"]+" on left side of \?\? is unnecessary\. Use \-> instead\.$#'
            identifier: nullsafe.neverNull
    excludePaths:
        analyseAndScan:
            # ip2region 官方 binding 原样引入（无类型声明的老式代码，上游维护），
            # 不做静态分析；升级时随上游整文件覆盖。调用侧（App\Support\Ip2Region）
            # 以运行时 require_once 加载并对动态调用行内豁免（@phpstan-ignore）。
            - app/Support/ip2region/Searcher.class.php
