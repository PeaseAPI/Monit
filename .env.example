APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Monit 仅支持 MySQL 8.0+（utf8mb4），必须配置以下数据库连接
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=monit
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------- Monit 专属（规格书） ----------------
# Cron 密钥（§13.2：/cron?key= 鉴权；未配置或为空时 /cron 端点直接 403（fail-closed））
APP_CRON_KEY=change-this-cron-key

# 社交登录（§12.3：8 海外 + 5 国内）
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WEIBO_CLIENT_ID=
WEIBO_CLIENT_SECRET=
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 支付网关（§11：22 处理器）
# 提示：以下支付密钥均可登录后台「系统设置 → 支付网关密钥」在线配置，
# 保存后自动写入 .env 并清理配置缓存；此处仅作部署预填/参考。验签密钥未配置时回调一律拒绝（fail-closed）。
# 说明：标注「验签」的键用于 webhook 回调签名校验，采用 fail-closed 语义——
# 未配置时对应网关的支付回调将被直接拒绝（400），请务必与网关后台的签名密钥保持一致。
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PADDLE_VENDOR_ID=
PADDLE_VENDOR_AUTH_CODE=
PADDLE_PUBLIC_KEY=
PADDLE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYU_POS_ID=
PAYU_SECOND_KEY=
PAYU_CLIENT_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=sandbox-api.iyzipay.com
IYZICO_WEBHOOK_SECRET=
CRYPTOCOM_MERCHANT_ID=
CRYPTOCOM_SECRET_KEY=
CRYPTOCOM_WEBHOOK_SECRET=
MYFATOORAH_API_KEY=
MYFATOORAH_IS_TEST=true
MYFATOORAH_WEBHOOK_SECRET=
KLARNA_USERNAME=
KLARNA_PASSWORD=
KLARNA_REGION=eu
KLARNA_WEBHOOK_SECRET=
PLISIO_API_KEY=
PLISIO_WEBHOOK_SECRET=
REVOLUT_API_KEY=
REVOLUT_PUBLIC_ID=
REVOLUT_WEBHOOK_SECRET=
ONEPAY_MERCHANT_CODE=
ONEPAY_MERCHANT_KEY=
ONEPAY_WEBHOOK_SECRET=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 对象存储（M17 §14.8：Offload 插件；亦可在后台「存储卸载」设置组配置）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# 短信验证（M17 §12.5：log/aliyun/tencent；亦可在后台「短信验证」设置组配置）
SMS_PROVIDER=log
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_SDK_APP_ID=
SMS_TENCENT_SIGN_NAME=
SMS_TENCENT_TEMPLATE_ID=

# GeoIP 访客国家识别（可选）：放置 db-ip/GeoLite2 country mmdb 后自动启用
# 下载：curl -L https://download.db-ip.com/free/dbip-country-lite-$(date +%Y-%m).mmdb.gz | gunzip > storage/app/geoip/country.mmdb
GEOIP_MMDB_PATH=
